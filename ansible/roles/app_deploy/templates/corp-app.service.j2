# /etc/systemd/system/corp-app.service
# Generated by Ansible — do not edit manually.
# Source: ansible/roles/app_deploy/templates/corp-app.service.j2
#
# Instance-owned unit (design-spec.md G7, §8.3):
#   Rendered by app_deploy to /etc/systemd/system/corp-app.service.
#   The application image bakes NO corp-app.service unit (G7); this unit
#   is a runtime artefact owned by the instance configuration, not the image.
#
#   This unit is NOT enabled or started by app_deploy. app_release enables
#   and starts it after running the Alembic migrations (design-spec.md §8.4).

[Unit]
Description=Minimal corporate application (loopback health endpoint + MariaDB probe)
After=network-online.target
Wants=network-online.target
# No After=mariadb.service: the database is on a remote host, not this system.

[Service]
Type=simple
ExecStart={{ app_entrypoint }}
Restart=on-failure
StandardOutput=journal
StandardError=journal
# Lightweight sandboxing — compatible with the payload under /opt/corp-app
# (resolves to /var/opt on bootc — writable) and read-only access to
# /etc/corp-app/config.ini:
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
