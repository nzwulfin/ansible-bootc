# /etc/systemd/system/corp-app.service
# Generated by Ansible — do not edit manually.
# Source: ansible/roles/app_deploy/templates/corp-app.service.j2
#
# Instance-owned runtime artefact: rendered by app_deploy, enabled/started by
# app_release. The application image bakes no unit.

[Unit]
Description=Minimal corporate application (loopback health endpoint + MariaDB probe)
After=network-online.target
Wants=network-online.target
# No After=mariadb.service: the database is on a remote host, not this system.

[Service]
Type=simple
ExecStart={{ app_entrypoint }}
Restart=on-failure
StandardOutput=journal
StandardError=journal
# ProtectSystem=strict mounts the filesystem read-only; add ReadWritePaths=
# via a drop-in if a workload needs to write to a specific path.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
