# /etc/corp-app/config.ini
# Generated by Ansible — do not edit manually.
# Source: ansible/roles/app_deploy/templates/config.ini.j2
#
# Interface contract (design-spec.md G12, §9):
#   This file is deployed to EXACTLY /etc/corp-app/config.ini — the path
#   is hardcoded in the application executable (app/corp-app/src/main.py)
#   and must match the dest: of the Ansible template task. A divergence
#   between any two of these three locations silently breaks the application.
#
#   Section and key names below must match what main.py reads via configparser.
#   No bind_address key: the application hardcodes 0.0.0.0 as the listen
#   address; the bind address is not config-driven (G12, design-spec.md §6.3).

[database]
host = {{ db_host }}
port = {{ db_port | default(3306) }}
name = {{ app_db_name }}
user = {{ app_db_user }}
password = {{ app_db_password }}

[server]
port = {{ app_port }}
