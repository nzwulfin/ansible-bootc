# Database workload image — derives from the corporate base image. Adds MariaDB
# server and client, the Python DB driver used by the ansible.mariadb modules,
# the corporate MariaDB baseline config, resource-limit drop-in, and database
# tuned profile. mariadb is enabled so the service self-initialises on first
# boot with the corporate config already in place.

FROM corp-base:latest

# Engine, client, and DBA operator toolset — baked because they are host-coupled
# and frequently needed; Ansible must not install OS packages at runtime.
RUN dnf install -y \
        mariadb-server \
        mariadb \
        python3-PyMySQL \
        mariadb-backup \
        lsof \
        strace \
        procps-ng \
        sysstat \
        jq \
    && dnf clean all

# Episodic diagnostics (tcpdump and similar) are deliberately NOT baked: they
# are manual break-glass installs during an active incident, and baking them
# would broaden the attack surface for rarely exercised capabilities.

# Corporate MariaDB config, systemd resource-limit drop-in, tuned profile.
COPY rootfs/ /

RUN systemctl enable mariadb

# Broad mysql service is the bake-time posture; the mariadb_instance role
# narrows it to the application host IP at instance provisioning.
RUN firewall-offline-cmd --add-service=mysql

# Profile name must match the baked /usr/lib/tuned/corp-database profile.
RUN echo 'corp-database' > /etc/tuned/active_profile \
    && echo 'manual' > /etc/tuned/profile_mode
