# Application runtime image — the single corporate Python baseline. Application
# teams build on this image via Ansible (app_deploy + app_release). It bakes no
# application code or executable, carries no systemd unit, and opens no firewall
# port. There is no rootfs/ directory by design: nothing beyond dnf and pip
# content belongs here.
#
# BUILD ORDER:
#   scripts/generate-demo-keys.sh
#   podman build -t corp-base:latest images/base/
#   podman build -t corp-app:latest images/application/

FROM corp-base:latest

# Corporate Python stack (RPM portion), installed and cleaned in a single layer.
# Downstream consumers must not re-install or re-pin any of it; app teams install
# only their own pinned extras into the app venv (see the app_deploy role).
RUN dnf install -y --nodocs \
        python3 \
        python3-pip \
        ca-certificates \
        tzdata \
        git \
        tar \
        gzip \
        unzip \
        python3-setuptools \
        python3-PyMySQL \
        python3-psycopg2 \
    && dnf clean all

# Data-abstraction layer: SQLAlchemy, Alembic, and Pydantic are not RPM-packaged
# at the corporate-pinned versions, so they are installed at build time from the
# committed requirement set.
COPY requirements-corporate.txt /tmp/requirements-corporate.txt
RUN pip3 install --no-cache-dir \
        --requirement /tmp/requirements-corporate.txt \
    && rm /tmp/requirements-corporate.txt

# bootc mounts / read-only with /var persistent: symlink /opt/corp-app into
# /var/opt so Ansible can deploy the payload to persistent storage.
RUN mkdir -p /var/opt/corp-app && ln -s /var/opt/corp-app /opt/corp-app
