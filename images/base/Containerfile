# Base bootc image — management layer for all workload images (database, application).
#
# Provides the pinned `ansible` management account (UID/GID 5000), the first-contact
# provisioning key (PSK), key-only SSH baseline, firewall state, and platform toolset.
#
# BUILD ORDER: run scripts/generate-demo-keys.sh at the repo root before building —
# it writes the PSK into the build context. The build fails without it, and keys
# generated after a build leave the control node unable to reach images built with
# the old key.
#
# Note: `bootc container lint` warns about content under /var. Expected: bootc
# applies /var at initial install and never re-applies it on upgrade, which is
# exactly the "present at first contact, never resurrected" PSK lifecycle.

FROM quay.io/centos-bootc/centos-bootc:stream10

# Platform toolset, installed and cleaned in a single layer. Everything an image
# needs is baked at build time; Ansible never runs a package manager at runtime.
RUN dnf install -y --nodocs \
        sudo \
        openssh-server \
        python3 \
        rsync \
        iproute \
        firewalld \
        tuned \
        tmux \
        vim-minimal \
        bind-utils \
    && dnf clean all

# Baked configuration; rootfs/ mirrors the target filesystem:
#   etc/sudoers.d/99-ansible                           -> NOPASSWD sudo rule
#   etc/ssh/sshd_config.d/50-corporate-hardening.conf  -> SSH baseline
#   usr/lib/sysusers.d/ansible.conf                    -> account, UID/GID 5000
#   usr/lib/tmpfiles.d/ansible-home.conf               -> home tree
#   var/home/ansible/.ssh/authorized_keys              -> PSK, first contact only
COPY rootfs/ /

# The ansible user does not exist at build time, so ownership is numeric. Boot-time
# hooks do not re-enforce ownership or modes on existing files — the image content
# must be correct or SSH refuses the authorized_keys file. rm drops the .gitkeep
# placeholder so it is never baked into the image layer.
RUN test -f /var/home/ansible/.ssh/authorized_keys || \
    { echo "ERROR: /var/home/ansible/.ssh/authorized_keys is missing from the build context." >&2; \
      echo "Run 'scripts/generate-demo-keys.sh' at the repository root before building this image." >&2; \
      exit 1; } \
    && rm -f /var/home/ansible/.ssh/.gitkeep \
    && chown -R 5000:5000 /var/home/ansible \
    && chmod 0700 /var/home/ansible /var/home/ansible/.ssh \
    && chmod 0600 /var/home/ansible/.ssh/authorized_keys

# sudo ignores sudoers files that are not root-owned mode 0440; COPY does not
# guarantee that state.
RUN chown root:root /etc/sudoers.d/99-ansible \
    && chmod 0440 /etc/sudoers.d/99-ansible

RUN systemctl enable sshd firewalld tuned

# Offline firewall/tuned edits: no daemon runs at build time, so the runtime
# tools (firewall-cmd, tuned-adm) cannot be used.
RUN firewall-offline-cmd --add-service=ssh

RUN printf 'throughput-performance\n' > /etc/tuned/active_profile \
    && printf 'manual\n' > /etc/tuned/profile_mode
