# Git worktrees (managed by git wt)
.worktrees/

# Generated PSK — written by scripts/generate-demo-keys.sh into the base image
# build context. This is a build artifact and must never be committed.
# Interface: path must exactly match what scripts/generate-demo-keys.sh writes.
images/base/rootfs/var/home/ansible/.ssh/authorized_keys

# Ansible private keys and vault credentials.
# Public keys are also excluded; ansible/keys/.gitignore is the authoritative
# source for that directory — no negation patterns here to avoid conflicts.
ansible/keys/id_*
ansible/keys/.vault_pass

# Ansible retry files
*.retry

# Python byte-code
__pycache__/
*.pyc
*.pyo

# System / Editor
.DS_Store
*.swp
*~
