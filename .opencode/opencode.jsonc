{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    // File discovery, inspection, and authoring
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },

    // Subagent orchestration
    { "action": "subagent", "resource": "*", "effect": "allow" },

    // Hard deny all shell commands by default (no package installation, no arbitrary execution)
    { "action": "shell", "resource": "*", "effect": "deny" },

    // Allow Git commands by default...
    { "action": "shell", "resource": "git *", "effect": "allow" },

    // ...EXCEPT destructive or remote operations:
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },
    { "action": "shell", "resource": "git reset *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },
    { "action": "shell", "resource": "git checkout *", "effect": "deny" },
    { "action": "shell", "resource": "git config *", "effect": "deny" }
  ]
}
